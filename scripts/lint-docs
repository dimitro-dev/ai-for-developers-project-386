#!/usr/bin/env node
'use strict';

// Гейт контракта размещения (FR17 задачи process/003). Проверяет два инварианта:
//   (а) в документации нет сырых вызовов инструментов — команда живёт в Makefile;
//   (б) каждая упомянутая цель `make <имя>` действительно существует в одном из Makefile.
//
// Лазейка (FR18): маркер-комментарий непосредственно перед блоком снимает проверку (а)
// с этого блока и требует однострочного обоснования в самом маркере:
//   <!-- lint-docs: allow-raw — почему сырой вызов здесь уместен -->

const fs = require('node:fs');
const path = require('node:path');

const ROOT = path.resolve(__dirname, '..');

// Область проверки: файлы этих имён в любом каталоге плюс `docs/*.md` (FR17).
const WATCHED_NAMES = new Set(['AGENTS.md', 'architecture.md', 'README.md']);

// Каталоги, в которые не заходим вовсе.
const SKIPPED_DIRS = new Set([
  '.git',
  'node_modules',
  'dist',
  'build',
  'coverage',
  '.expo',
  'android',
  'ios',
]);

// Исключения области (FR17): исторические документы задач, кит со своим валидатором,
// файл авточекера Hexlet (NFR3).
const EXCLUDED = [
  'tasks/',
  'docs/ui-spec-kit/',
  '.github/workflows/README.md',
];

const RAW_CALLS = [
  { re: /npm run\b/, name: 'npm run' },
  { re: /npm test\b/, name: 'npm test' },
  { re: /npm ci\b/, name: 'npm ci' },
  { re: /npx /, name: 'npx' },
  { re: /docker compose/, name: 'docker compose' },
  { re: /node --/, name: 'node --' },
  { re: /tsc --/, name: 'tsc --' },
  { re: /jest /, name: 'jest' },
];

const MARKER = /<!--\s*lint-docs:\s*allow-raw\s*(.*?)-->/;
const MAKE_MENTION = /\bmake\s+(?:-C\s+([^\s`'"]+)\s+)?([a-z][a-z0-9._-]*)/g;

function walk(dir, files) {
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const full = path.join(dir, entry.name);
    const rel = path.relative(ROOT, full);
    if (entry.isDirectory()) {
      if (SKIPPED_DIRS.has(entry.name)) continue;
      if (EXCLUDED.some((prefix) => prefix.endsWith('/') && rel.startsWith(prefix.slice(0, -1)))) continue;
      walk(full, files);
      continue;
    }
    if (!entry.isFile()) continue;
    if (EXCLUDED.includes(rel)) continue;
    const inDocsRoot = path.dirname(rel) === 'docs' && entry.name.endsWith('.md');
    if (WATCHED_NAMES.has(entry.name) || inDocsRoot) files.push(rel);
  }
  return files;
}

function makefiles() {
  const found = [];
  const add = (rel) => {
    if (fs.existsSync(path.join(ROOT, rel))) found.push(rel);
  };
  add('Makefile');
  add('make/common.mk');
  for (const parent of ['apps', 'packages']) {
    const dir = path.join(ROOT, parent);
    if (!fs.existsSync(dir)) continue;
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      if (entry.isDirectory()) add(path.join(parent, entry.name, 'Makefile'));
    }
  }
  add('infra/Makefile');
  add('tasks/Makefile');
  return found;
}

function targetsOf(relMakefile) {
  const targets = new Set();
  const text = fs.readFileSync(path.join(ROOT, relMakefile), 'utf8');
  for (const line of text.split('\n')) {
    const match = /^([a-zA-Z0-9_.\-\/ ]+):(?!=)/.exec(line);
    if (!match) continue;
    for (const name of match[1].trim().split(/\s+/)) {
      if (name && !name.startsWith('.')) targets.add(name);
    }
  }
  return targets;
}

// Маркер снимает проверку (а) с блока, идущего сразу за ним: с ближайшего fenced-блока,
// если он начинается следующей непустой строкой, иначе — с абзаца до пустой строки.
function suppressedLines(lines, markers) {
  const suppressed = new Set();
  lines.forEach((line, index) => {
    const marker = MARKER.exec(line);
    if (!marker) return;
    markers.push({ line: index + 1, reason: marker[1].trim() });
    let start = index + 1;
    while (start < lines.length && lines[start].trim() === '') start += 1;
    if (start >= lines.length) return;
    if (lines[start].trim().startsWith('```')) {
      suppressed.add(start);
      for (let i = start + 1; i < lines.length; i += 1) {
        suppressed.add(i);
        if (lines[i].trim().startsWith('```')) break;
      }
      return;
    }
    for (let i = start; i < lines.length && lines[i].trim() !== ''; i += 1) suppressed.add(i);
  });
  return suppressed;
}

function main() {
  const files = walk(ROOT, []).sort();
  const makeFiles = makefiles();
  const targetsByZone = new Map();
  const allTargets = new Set();
  for (const rel of makeFiles) {
    const targets = targetsOf(rel);
    targetsByZone.set(path.dirname(rel) === '.' ? '' : path.dirname(rel), targets);
    for (const target of targets) allTargets.add(target);
  }

  const problems = [];
  const markers = [];

  for (const rel of files) {
    const lines = fs.readFileSync(path.join(ROOT, rel), 'utf8').split('\n');
    const fileMarkers = [];
    const suppressed = suppressedLines(lines, fileMarkers);
    for (const marker of fileMarkers) {
      markers.push({ file: rel, ...marker });
      if (!marker.reason || marker.reason.replace(/^[—–-]\s*/, '').length < 8) {
        problems.push(`${rel}:${marker.line}  маркер lint-docs без однострочного обоснования`);
      }
    }

    lines.forEach((line, index) => {
      if (!suppressed.has(index)) {
        for (const call of RAW_CALLS) {
          if (call.re.test(line)) {
            problems.push(`${rel}:${index + 1}  сырой вызов «${call.name}»: ${line.trim()}`);
          }
        }
      }
      MAKE_MENTION.lastIndex = 0;
      let mention;
      while ((mention = MAKE_MENTION.exec(line)) !== null) {
        const [, zone, target] = mention;
        if (zone === undefined) {
          if (!allTargets.has(target)) {
            problems.push(`${rel}:${index + 1}  цель «make ${target}» не определена ни в одном Makefile`);
          }
          continue;
        }
        const zoneTargets = targetsByZone.get(zone.replace(/\/$/, ''));
        if (!zoneTargets) {
          problems.push(`${rel}:${index + 1}  зона «${zone}» не имеет Makefile: make -C ${zone} ${target}`);
        } else if (!zoneTargets.has(target) && !targetsByZone.get('').has(target)) {
          problems.push(`${rel}:${index + 1}  цель «${target}» не определена в ${zone}/Makefile`);
        }
      }
    });
  }

  const summary = `lint-docs: ${files.length} документов, ${makeFiles.length} Makefile, ` +
    `${problems.length} нарушений, ${markers.length} маркеров`;

  if (markers.length > 0) {
    console.log('Маркеры-лазейки:');
    for (const marker of markers) console.log(`  ${marker.file}:${marker.line}  ${marker.reason}`);
  }
  if (problems.length > 0) {
    console.error('Нарушения контракта размещения:');
    for (const problem of problems) console.error(`  ${problem}`);
    console.error(summary);
    process.exit(1);
  }
  console.log(summary);
}

main();
