# Состав контекста сборки образа. Паттерн без `**/` матчится только от корня контекста,
# поэтому всё, что встречается на любой глубине, перечислено с этим префиксом.

# Зависимости ставятся внутри образа по package-lock.json.
**/node_modules

.git

# Бандлы собирает этап build; локальные каталоги экспорта в контекст не едут.
apps/client/dist

# Continuous native generation: нативные проекты пересоздаёт prebuild, серверу они не нужны.
apps/client/android
apps/client/ios
**/.expo

# Локальные файлы харнессов — вне git, в образе им тем более не место.
.claude
.opencode
CLAUDE.md
.mcp.json
opencode.json*

# Логи, окружение, отчёты и мусор ФС.
**/*.log
.env
.env.*
**/coverage
**/*.tsbuildinfo
**/.DS_Store
